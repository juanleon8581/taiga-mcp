{
  "name": "taiga-mcp",
  "version": "0.2.1",
  "description": "MCP server for Taiga project management API",
  "keywords": [
    "mcp",
    "taiga",
    "project-management",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "taiga-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
